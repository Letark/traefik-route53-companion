# Route53 hosted zone ID
HOSTED_ZONE_ID=

# DNS value all records will point to (IP address or CNAME target hostname)
TARGET_DOMAIN=

# Record type: CNAME (default) or A
TARGET_RECORD_TYPE=CNAME

# Comma-separated list of domains to manage
# Only hostnames matching these domains will have records created/deleted
DOMAINS=

# TTL in seconds for created records
RECORD_TTL=300

# Set to true to log actions without making any Route53 changes
DRY_RUN=false

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# AWS credentials
# Leave blank to use IAM role authentication (recommended for EC2/ECS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
